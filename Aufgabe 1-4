#include<iostream>
using namespace std;
#include"header.h"

#define ANZ 10

int main()
{
	int messwerte[ANZ];
	double Mittelwert;
	double Summe = 0;

	for (int i = 0;i < ANZ;i++)
	{
		messwerte[i] = getMeasurement();
		cout << "Messwert " << i + 1 <<":" << messwerte[i] << endl;
	}

	for (int i = 0;i < ANZ;i++)
	{
		Summe += messwerte[i];
	}
	cout << endl;
	
	Mittelwert = (Summe) / ANZ;

	cout << "Mittelwert=" << Mittelwert << endl;
 
}
